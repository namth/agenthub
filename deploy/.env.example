# Cấu hình AgentHub trên server — chép thành .env (quyền 600), KHÔNG commit.
PORT=1407
BASE_URL=https://agent.oa.io.vn
DATABASE_PATH=./data/agenthub.db
JWT_SECRET=                      # tự sinh: openssl rand -hex 32
TZ_DISPLAY=Asia/Ho_Chi_Minh

# GitHub (OAuth App: callback = BASE_URL/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER=namth               # quản trị hệ thống (DEC-17); trống = dùng GITHUB_REPO_OWNER
GITHUB_REPO_OWNER=namth          # chỉ dùng tạo dự án đầu tiên khi DB trống; thêm dự án khác ở trang Dự án
GITHUB_REPO_NAME=agenthub
GITHUB_PERSONAL_ACCESS_TOKEN=    # fine-grained, các repo do AgentHub quản lý: Metadata R, Contents RW, Issues RW, Pull requests RW, Webhooks RW
GITHUB_WEBHOOK_SECRET=           # tự sinh; webhook tự tạo khi thêm dự án (URL: BASE_URL/api/webhooks/github)
CI_GATE=false                    # true khi workflow CI đã chạy cho mọi PR

# Telegram (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Máy con
RUNNERS_DIR=./runners            # binary runner cho /download và /install.sh (deploy/build.sh sinh ra)
RUNNER_REGISTRATION_KEY=         # tuỳ chọn, cách cũ; thêm máy mới nên dùng nút "Thêm máy mới" (mã tham gia)
