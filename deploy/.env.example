# Cấu hình AgentHub trên server — chép thành .env (quyền 600), KHÔNG commit.
PORT=1407
BASE_URL=https://agent.oa.io.vn
DATABASE_PATH=./data/agenthub.db
JWT_SECRET=                      # tự sinh: openssl rand -hex 32
TZ_DISPLAY=Asia/Ho_Chi_Minh

# GitHub (OAuth App: callback = BASE_URL/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPO_OWNER=namth
GITHUB_REPO_NAME=agenthub
GITHUB_PERSONAL_ACCESS_TOKEN=    # fine-grained, chỉ repo này: Issues RW, Pull requests RW, Metadata R
GITHUB_WEBHOOK_SECRET=           # tự sinh; dán vào webhook GitHub (URL: BASE_URL/api/webhooks/github)
CI_GATE=false                    # true khi workflow CI đã chạy cho mọi PR

# Telegram (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Máy con
RUNNER_REGISTRATION_KEY=         # tự sinh; dùng khi đăng ký máy mới
